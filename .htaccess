# HostingInfo — clean URL routing
# Serves pages without a .php extension and maps /provider/<slug> to provider.php.

Options -MultiViews
DirectoryIndex index.php

RewriteEngine On
RewriteBase /

# 0) Retired blog posts still indexed by Google: temporarily redirect them to
# the homepage (302, not 301 - these slugs may be reused for new content later).

RewriteRule ^(cloudways-vs-wp-engine|kinsta-review|hostinger-review|best-siteground-alternatives|best-rapyd-cloud-alternatives|best-hosting-com-alternatives|best-hostinger-alternatives|best-kinsta-alternatives|best-liquid-web-alternatives|best-wp-engine-alternatives|best-nodejs-hosting-providers|best-laravel-hosting-providers|best-cloudways-alternatives|best-openclaw-hosting-providers|cloudways-review|dreamhost-review|rapyd-cloud-review|best-website-builders|xcloud-hosting-review|kinsta-vs-siteground|liquid-web-review|wp-engine-review|hosting-com-review|wp-engine-vs-kinsta|best-black-friday-web-hosting-deals|siteground-review|best-dreamhost-alternatives)/?$ / [R=302,L,NC]

# 1) Canonicalize old query-string provider links: /provider.php?slug=X -> /provider/X
RewriteCond %{THE_REQUEST} \s/+provider\.php\?slug=([a-zA-Z0-9\-]+)[\s&] [NC]
RewriteRule ^ /provider/%1? [R=301,L]

# 2) Canonicalize direct requests for index.php to the site root
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# 3) Canonicalize any other direct .php request to its extensionless URL
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4) Internally map /provider/<slug> to provider.php?slug=<slug>
RewriteRule ^provider/([a-zA-Z0-9\-]+)/?$ provider.php?slug=$1 [L,QSA]

# 4a) Internally map /providers/<category>-hosting to providers.php
RewriteRule ^providers/([a-zA-Z0-9\-]+)/?$ providers.php?category_slug=$1 [L,QSA]

# 4b) Internally map /sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 5) Internally map extensionless page requests (e.g. /providers, /deals) to their .php file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-zA-Z0-9_\-]+)/?$ $1.php [L,QSA]
